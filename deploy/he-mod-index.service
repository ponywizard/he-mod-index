[Unit]
Description=Home Equestria mod index
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=he-mod-index
Group=he-mod-index
WorkingDirectory=/srv/he-mod-index
EnvironmentFile=/etc/he-mod-index.env
ExecStart=/srv/he-mod-index/he-mod-index
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/he-mod-index/data
CapabilityBoundingSet=
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
